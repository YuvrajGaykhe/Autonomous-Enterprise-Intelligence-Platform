# =============================================================================
# AI CEO — Layer 1 Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_ceo_layer1
POSTGRES_USER=ai_ceo
POSTGRES_PASSWORD=changeme

# Constructed from the above; used by SQLAlchemy and Alembic.
# You can override this directly if needed.
DATABASE_URL=postgresql://ai_ceo:changeme@localhost:5432/ai_ceo_layer1

# --- FastAPI ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# --- Mock Source Service (Docker Compose internal) ---
# URL of the mock-source container; used by both Odoo mock and REST connectors.
MOCK_SOURCE_BASE_URL=http://mock-source:8080

# --- CSV Connector ---
# Path to the directory containing demo CSV files.
CSV_DATA_DIR=data/demo

# --- Odoo Mock Connector ---
# These env vars are referenced by connector_configs; values are placeholders.
ODOO_MOCK_URL=http://mock-source:8080/odoo
ODOO_MOCK_API_KEY=changeme

# --- Generic REST Connector ---
REST_MOCK_URL=http://mock-source:8080/rest
REST_MOCK_API_KEY=changeme

# --- Ingestion ---
# Default page size for batch ingestion.
INGESTION_DEFAULT_PAGE_SIZE=100
# Maximum retry attempts for transient connector errors.
INGESTION_MAX_RETRIES=3
# Base delay in seconds for exponential backoff.
INGESTION_RETRY_BASE_DELAY=1.0

# --- Security ---
# Set to a long random string in production. Not used for auth in Layer 1,
# but reserved for future internal service-to-service signing.
INTERNAL_SECRET_KEY=changeme-replace-with-64-char-random-string
