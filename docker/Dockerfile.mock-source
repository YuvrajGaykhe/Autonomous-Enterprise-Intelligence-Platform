# AI CEO — Mock Source Service Dockerfile
# Minimal HTTP server for container verification (A2).
# Task C3 will extend this with actual Odoo/REST mock endpoints.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy only the mock-source server script.
COPY docker/mock_source.py ./mock_source.py

EXPOSE 8080

CMD ["python", "mock_source.py"]
